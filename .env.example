# Supabase (required for local dev)
# For release builds, .env.production is committed with the public anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: apply migrations automatically with npm run supabase:setup
# Supabase Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Optional: first-time admin setup script (npm run setup:admin) — never ship in the app
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=
