{
  "name": "orbdyn",
  "version": "1.0.8",
  "description": "Orbdyn — team workspace for tasks, documents, calendar and notifications. Powered by Supabase.",
  "main": "electron/main.js",
  "author": "Orbdyn",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prestart": "npm run build:ui",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "build:ui": "node scripts/validate-build-env.mjs && vite build && node scripts/verify-build-bundle.mjs",
    "dev:ui": "vite",
    "build:win": "npm run build:ui && electron-builder --win",
    "build:mac": "npm run build:ui && electron-builder --mac",
    "build:all": "npm run build:ui && electron-builder --win --mac",
    "release:win": "npm run build:ui && electron-builder --win --publish always",
    "release:mac": "npm run build:ui && electron-builder --mac --publish always",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "supabase:check": "node scripts/supabase-setup.mjs",
    "setup:admin": "node scripts/setup-admin.mjs",
    "update:icons": "node scripts/update-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "pg": "^8.16.3",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.26",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.orbdyn.desktop",
    "productName": "Orbdyn",
    "files": [
      "electron/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "csixneutral",
      "repo": "orbdyn-desktop",
      "private": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Orbdyn",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}
